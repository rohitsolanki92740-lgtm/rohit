#include<stdio.h>
#include<iostream.h>
void main()
{
	int a,b,ans;
	cout<<"\nenter value of a:";
	cin>>a;
	cout<<"\nenter value of b:";
	cin>>b;
	ans=a+b;
	cout<<"\nsum of a and b is="<<ans;
	ans=a-b;
	cout<<"\nsubstraction of and b is="<<ans;
	ans=a*b;
	cout<<"\nmultiplication of a and b is="<<ans;
	ans=a/b;
	cout<<"\ndivison of a and b is="<<ans;
}