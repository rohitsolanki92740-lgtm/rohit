SQL> CREATE OR REPLACE PROCEDURE change_name_caps(p_rollno NUMBER) IS
  2  v_count NUMBER;
  3  e_no_student EXCEPTION;
  4  BEGIN
  5  SELECT COUNT(*) INTO v_count FROM student5 WHERE rollno = p_rollno;
  6  IF v_count = 0 THEN
  7  RAISE e_no_student;
  8  ELSE
  9  UPDATE student5
 10  SET sname = UPPER(sname)
 11  WHERE rollno = p_rollno;
 12  DBMS_OUTPUT.PUT_LINE('Name updated to uppercase');
 13  COMMIT;
 14  END IF;
 15  EXCEPTION
 16  WHEN e_no_student THEN
 17  RAISE_APPLICATION_ERROR(-20001,
 18  'Student with Roll No ' || p_rollno || ' does not exist');
 19  END;
 20  /

