SQL> CREATE OR REPLACE PROCEDURE show_student(p_sid NUMBER) IS
  2  v_sname VARCHAR2(30);
  3  v_dob DATE;
  4  v_address VARCHAR2(50);
  5  v_city VARCHAR2(20);
  6  BEGIN
  7  SELECT sname, DOB, address, city
  8  INTO v_sname, v_dob, v_address, v_city
  9  FROM student5
 10  WHERE sid = p_sid;
 11  DBMS_OUTPUT.PUT_LINE('Sid : ' || p_sid);
 12  DBMS_OUTPUT.PUT_LINE('Sname : ' || v_sname);
 13  DBMS_OUTPUT.PUT_LINE('DOB : ' || v_dob);
 14  DBMS_OUTPUT.PUT_LINE('Address : ' || v_address);
 15  DBMS_OUTPUT.PUT_LINE('City : ' || v_city);
 16  EXCEPTION
 17  WHEN NO_DATA_FOUND THEN
 18  DBMS_OUTPUT.PUT_LINE('Student not found');
 19  END;
 20  /

