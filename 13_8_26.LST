SQL> DECLARE
  2  isPrime BOOLEAN;
  3  BEGIN
  4  FOR n IN 2..50 LOOP
  5  isPrime := TRUE;
  6  FOR i IN 2..TRUNC(SQRT(n)) LOOP
  7  IF MOD(n,i) = 0 THEN
  8  isPrime := FALSE;
  9  EXIT;
 10  END IF;
 11  END LOOP;
 12  IF isPrime THEN
 13  DBMS_OUTPUT.PUT_LINE(n);
 14  END IF;
 15  END LOOP;
 16  END;
