SQL> CREATE OR REPLACE PROCEDURE print_descending(n NUMBER) IS
  2  BEGIN
  3  IF n >= 1 THEN
  4  DBMS_OUTPUT.PUT_LINE(n);
  5  print_descending(n - 1);
  6  END IF;
  7  END;
