#include<iostream.h>
#include<conio.h>
void main()
{
	int i,j;
	clrscr();
	for(i=1;i<=5;i++)
	{
		for(j=5;j>=i;j--)
		{
			cout<<" ";
		}
		for(j=1;j<=i;j++)
		{
			if(j%2==0)
			{
			cout<<"  "<<0<<" ";
			}
			else
			{
				cout<<" "<<1;
			}
		}
		cout<<endl;
	}
	getch();
}
